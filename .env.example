# Server
PORT=8080
NODE_ENV=development
PUBLIC_BASE_URL=https://nucleus.soleusforce.cn

# PostgreSQL
DATABASE_URL=postgres://nucleus:YOUR_PASSWORD@127.0.0.1:5432/nucleus

# Auth
JWT_SECRET=change-me-to-a-long-random-secret

# LLM Provider (OpenAI-compatible)
LLM_BASE_URL=https://switchbase.vip/v1
LLM_API_KEY=your-switchbase-api-key
LLM_MODEL=gemini-4-hydrogen
LLM_RACE_MODEL=gemini-4-neon

# Server
PORT=8080
NODE_ENV=development
PUBLIC_BASE_URL=https://nucleus.soleusforce.cn

# PostgreSQL
DATABASE_URL=postgres://nucleus:YOUR_PASSWORD@127.0.0.1:5432/nucleus

# Auth
JWT_SECRET=change-me-to-a-long-random-secret

# DeepSeek API (OpenAI-compatible)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek-flash
LLM_STREAM_IDLE_TIMEOUT_MS=60000
LLM_FALLBACK_MODEL=deepseek-v4-pro
LLM_VISION_MODEL=deepseek-flash
